    <propertyOrganizer/>
    <stickyBoard>
      <stickyNote location="31,341" association="FCMComposite_1_8">
        <body xmi:type="utility:ConstantString" string="Uses a fixed queue name and will&#xA;pick up only messages that match&#xA;the encoded hostname CorrelId."/>
      </stickyNote>
      <stickyNote location="21,680" association="FCMComposite_1_13">
        <body xmi:type="utility:ConstantString" string="The reply message has the required correlation ID in the&#xA;MsgId field, so this node copies the MsgId into the CorrelId&#xA;so the Group Gather node can match it to the group."/>
      </stickyNote>
      <stickyNote location="107,16" association="FCMComposite_1_7">
        <body xmi:type="utility:ConstantString" string="Sets the CorrelId to the encoded hostname, and the&#xA;MQMD report option to pass both message and &#xA;correl IDs back in the response message. The Group&#xA;nodes will handle restoring the HTTP reply identifier."/>
      </stickyNote>
      <stickyNote location="626,15" association="FCMComposite_1_5">
        <body xmi:type="utility:ConstantString" string="Sends the message to the shared input&#xA;queue for the backend flow, and adds&#xA;it to the group with an MQ-generated&#xA;message ID."/>
      </stickyNote>
      <stickyNote location="621,578" association="FCMComposite_1_10">
        <body xmi:type="utility:ConstantString" string="The completed group has the HTTP&#xA;reply identifier restored automatically.&#xA;&#xA;It will also propagate the received reply&#xA;if it arrived in time, and will otherwise &#xA;trigger the Timeout terminal to allow&#xA;for timeout processing in the flow."/>
      </stickyNote>
    </stickyBoard>
