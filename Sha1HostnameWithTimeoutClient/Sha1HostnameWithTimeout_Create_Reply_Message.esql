

CREATE COMPUTE MODULE Sha1HostnameWithTimeout_Create_Reply_Message
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- No need to set the HTTP RequestIdentifier: the GroupComplete node will have done that for us

		-- Copy the actual reply from the group
		SET OutputRoot.JSON.Data = InputRoot.ComIbmGroupCompleteNode.Group.Replies.mqBackend.Reply.Root.JSON.Data;
		RETURN TRUE;
	END;

END MODULE;
